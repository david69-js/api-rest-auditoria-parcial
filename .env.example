# Puerto de la aplicación (Railway lo asigna automáticamente)
PORT=3000
NODE_ENV=development

# --- Opción A: variables sueltas (desarrollo local / docker-compose) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=app
DB_POOL_LIMIT=10

# --- Opción B: URL de conexión completa ---
# En Railway, añade el plugin de MySQL y usa la variable de referencia:
# MYSQL_URL=${{ MySQL.MYSQL_URL }}
# MYSQL_URL=mysql://user:password@host:3306/database
