# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Seguridad / JWT ---
# Cambia esta clave por una cadena larga y aleatoria en producción.
JWT_SECRET=cambia-esta-clave-super-secreta-en-produccion
# El token expira en 2 horas (requisito del examen).
JWT_EXPIRES_IN=2h
# Coste de bcrypt (10-12 recomendado).
BCRYPT_ROUNDS=10

# Sembrar usuarios de prueba + auditoría de api-rest al arrancar (true/false).
SEED_ON_START=true

# --- Base de datos (variables sueltas: local / docker-compose) ---
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=sris
DB_POOL_LIMIT=10

# --- Alternativa: URL de conexión completa (Railway, etc.) ---
# Si se define, tiene prioridad sobre las variables sueltas.
# MYSQL_URL=mysql://user:password@host:3306/sris
